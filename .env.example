# MiragePot Environment Configuration
# Copy this file to .env and modify as needed
# All values shown are defaults

# =============================================================================
# SSH Honeypot Settings
# =============================================================================

# Address to bind the SSH server (0.0.0.0 = all interfaces)
MIRAGEPOT_SSH_HOST=0.0.0.0

# Port for the SSH honeypot (2222 recommended for non-root)
# Use 22 for production (requires root or capabilities)
MIRAGEPOT_SSH_PORT=2222

# Path to SSH host key (auto-generated if not exists)
# MIRAGEPOT_HOST_KEY=./data/host.key

# SSH banner to present to clients
MIRAGEPOT_SSH_BANNER=SSH-2.0-OpenSSH_8.2p1 Ubuntu-4ubuntu0.5

# =============================================================================
# LLM/Ollama Settings
# =============================================================================

# Ollama model to use for generating responses
# Recommended: phi3 (good balance of speed and quality)
# Alternatives: llama2, mistral, codellama
MIRAGEPOT_LLM_MODEL=phi3

# Timeout for LLM requests (seconds)
MIRAGEPOT_LLM_TIMEOUT=30.0

# LLM temperature (0.0 = deterministic, 1.0 = creative)
MIRAGEPOT_LLM_TEMPERATURE=0.7

# Maximum tokens in LLM response
MIRAGEPOT_LLM_MAX_TOKENS=512

# How often to re-check Ollama connection (seconds)
MIRAGEPOT_LLM_CHECK_INTERVAL=30.0

# =============================================================================
# Dashboard Settings
# =============================================================================

# Dashboard bind address
MIRAGEPOT_DASHBOARD_HOST=localhost

# Dashboard port
MIRAGEPOT_DASHBOARD_PORT=8501

# Auto-refresh interval (seconds)
MIRAGEPOT_DASHBOARD_REFRESH=5

# =============================================================================
# Logging Settings
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
MIRAGEPOT_LOG_LEVEL=INFO

# Log format (Python logging format string)
# MIRAGEPOT_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Log file path (optional, logs to stdout if not set)
# MIRAGEPOT_LOG_FILE=./data/logs/miragepot.log

# =============================================================================
# Honeypot Identity Settings
# =============================================================================

# Fake hostname presented to attackers
MIRAGEPOT_HOSTNAME=miragepot

# Fake OS name
MIRAGEPOT_OS_NAME=Ubuntu

# Fake OS version
MIRAGEPOT_OS_VERSION=20.04.6 LTS

# Fake kernel version
MIRAGEPOT_KERNEL_VERSION=5.15.0-86-generic

# =============================================================================
# Security & Rate Limiting Settings
# =============================================================================

# Maximum concurrent connections from a single IP
# Prevents resource exhaustion attacks
MIRAGEPOT_MAX_CONNECTIONS_PER_IP=3

# Maximum total concurrent connections
# Global limit across all IPs
MIRAGEPOT_MAX_TOTAL_CONNECTIONS=50

# Time window for connection tracking (seconds)
# Connections older than this are cleaned up
MIRAGEPOT_CONNECTION_TIME_WINDOW=60

# Duration to block abusive IPs (seconds)
# IPs that exceed connection limits are blocked for this duration
MIRAGEPOT_BLOCK_DURATION=300

# Maximum session duration (seconds)
# Sessions longer than this are automatically terminated
# Set to 0 for unlimited
MIRAGEPOT_MAX_SESSION_DURATION=3600

# Log passwords to console (true/false)
# WARNING: Only enable in secure environments
# Passwords are always logged to session JSON files
MIRAGEPOT_LOG_PASSWORDS=false

# =============================================================================
# Real-time Attack Notifications
# =============================================================================

# Enable Discord/Telegram notifications for attacks (true/false)
MIRAGEPOT_NOTIFICATIONS_ENABLED=false

# Discord webhook URL for live attack notifications
# Create webhook: Discord Server → Channel Settings → Integrations → Webhooks
# Example: https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
MIRAGEPOT_DISCORD_WEBHOOK_URL=

# Telegram bot token (optional - leave empty to disable Telegram)
# Create bot: Message @BotFather on Telegram
MIRAGEPOT_TELEGRAM_BOT_TOKEN=

# Telegram chat ID (required if bot token is set)
# Get chat ID: Message your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
MIRAGEPOT_TELEGRAM_CHAT_ID=

# Minimum risk level to trigger notifications (low, medium, high, critical)
# Only sessions at or above this level will send notifications
MIRAGEPOT_NOTIFY_MIN_RISK=high

# Send notification when high-risk session ends (true/false)
MIRAGEPOT_NOTIFY_SESSION_END=true

# Send real-time notifications for high-threat commands (true/false)
MIRAGEPOT_NOTIFY_REALTIME=true

# Notify when honeytokens are accessed (viewed) (true/false)
MIRAGEPOT_NOTIFY_HONEYTOKENS_ACCESS=true

# Notify when honeytokens are exfiltrated (curl/wget) (true/false)
MIRAGEPOT_NOTIFY_HONEYTOKENS_EXFIL=true

# Attach full session JSON to end-of-session notifications (true/false)
MIRAGEPOT_NOTIFY_INCLUDE_JSON=true

# Include text summary in notifications (true/false)
MIRAGEPOT_NOTIFY_INCLUDE_SUMMARY=true

# Maximum notifications per minute (rate limiting)
# Prevents spam during mass attacks
MIRAGEPOT_NOTIFY_RATE_LIMIT=10
